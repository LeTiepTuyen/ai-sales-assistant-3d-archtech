# AI provider
# Do not put real secrets in this example file. Copy to .env.local and set locally.
# This app reads GOOGLE_GENERATIVE_AI_API_KEY first, then GEMINI_API_KEY or GOOGLE_API_KEY.
GOOGLE_GENERATIVE_AI_API_KEY=NEEDS_INPUT
GEMINI_MODEL=gemini-3.5-flash

# Optional Supabase deployment setup
# Use the project URL from Supabase Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
# Use a publishable key, or the legacy anon key if needed.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Use a secret key, or the legacy service_role key if needed.
SUPABASE_SERVICE_ROLE_KEY=

# Demo admin guard
ADMIN_DEMO_PASSWORD=demo-admin-password

# App
NEXT_PUBLIC_APP_NAME=AI Sales Assistant for 3D Archtech
